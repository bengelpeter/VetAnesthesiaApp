@inherits LayoutComponentBase

<MudThemeProvider Theme="@_theme" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>

    <MudAppBar Elevation="1" Style="background-color:#5B8DEF; color:white;">
        <MudText Typo="Typo.h6">
            🐾 Vet Anesthesia Tracker
        </MudText>
    </MudAppBar>

    <MudMainContent Class="pa-4 mt-16">
        <MudContainer MaxWidth="MaxWidth.False">
            @Body
        </MudContainer>
    </MudMainContent>

</MudLayout>

@code {
    private MudTheme _theme = new()
    {
        PaletteLight = new PaletteLight
        {
            Primary = "#5B8DEF",
            Secondary = "#8FAADC",
            Background = "#F7F9FC",
            Surface = "#FFFFFF",
            AppbarBackground = "#5B8DEF",
            AppbarText = "#FFFFFF",
            TextPrimary = "#1F2A44"
        },
        LayoutProperties = new LayoutProperties
        {
            DefaultBorderRadius = "6px"
        }
    };
}
@inherits LayoutComponentBase

@inject NavigationManager Nav

<MudThemeProvider Theme="@_theme" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>

    <MudAppBar Elevation="0" Dense="true" Style="background-color:#17324d; color:white; border-bottom:1px solid rgba(255,255,255,0.08);">
        <MudText Typo="Typo.h6">
            VetPulse
        </MudText>
        <MudText Typo="Typo.caption" Class="ml-3" Style="opacity:0.8;">
            Anesthesia workflow
        </MudText>
        <MudSpacer />
        <MudButton Variant="Variant.Text" Style="color:white;" OnClick="GoPatients">
            Patients
        </MudButton>
        <MudButton Variant="Variant.Text" Style="color:white;" OnClick="GoWorkflowSetup">
            Workflow Setup
        </MudButton>
    </MudAppBar>

    <MudMainContent Class="pa-4 mt-16">
        <MudContainer MaxWidth="MaxWidth.False">
            @Body
        </MudContainer>
    </MudMainContent>

</MudLayout>

@code {
    private MudTheme _theme = new()
    {
        PaletteLight = new PaletteLight
        {
            Primary = "#4f80d8",
            Secondary = "#2d8c7a",
            Background = "#eff3f8",
            Surface = "#FFFFFF",
            AppbarBackground = "#17324d",
            AppbarText = "#FFFFFF",
            TextPrimary = "#1e2d3d"
        },
        LayoutProperties = new LayoutProperties
        {
            DefaultBorderRadius = "10px"
        }
    };

    private void GoPatients()
    {
        Nav.NavigateTo("/");
    }

    private void GoWorkflowSetup()
    {
        Nav.NavigateTo("/workflow-setup");
    }
}

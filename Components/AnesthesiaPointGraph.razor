@using VetAnesthesiaApp.Models

<div style="overflow-x:auto;">
    <div style="width:@SvgWidthPx">
        <div class="graph-legend">
            <div class="legend-item">
                <span class="legend-symbol hr-symbol">X</span>
                <span>Heart Rate</span>
            </div>

            <div class="legend-item">
                <span class="legend-symbol rr-symbol">O</span>
                <span>Respiratory Rate</span>
            </div>

            <div class="legend-item">
                <span class="legend-symbol sys-symbol">↑</span>
                <span>Systolic</span>
            </div>

            <div class="legend-item">
                <span class="legend-symbol dia-symbol">↓</span>
                <span>Diastolic</span>
            </div>

            <div class="legend-item">
                <span class="legend-symbol map-symbol">—</span>
                <span>MAP</span>
            </div>
        </div>

        <svg width="@SvgWidth" height="@Height" viewBox="0 0 @SvgWidth @Height" style="border:1px solid #ccc; background:white;">
            <rect x="0" y="0" width="@SvgWidth" height="@Height" fill="white" />

            @if (ActiveBucketId.HasValue)
            {
                var activeIndex = Buckets.FindIndex(b => b.Id == ActiveBucketId.Value);

                if (activeIndex >= 0)
                {
                    var activeX = GetX(activeIndex);
                    var left = activeX - (ColumnWidth / 2.0);

                    <rect x="@left"
                          y="@PaddingTop"
                          width="@ColumnWidth"
                          height="@(Height - PaddingTop - PaddingBottom)"
                          fill="#fff7cc"
                          opacity="0.7" />
                }
            }

            <!-- Horizontal grid lines -->
            @for (int i = 0; i <= YSteps; i++)
            {
                var value = MaxValue - (i * (MaxValue - MinValue) / YSteps);
                var y = GetY(value);

                <line x1="@PaddingLeft"
                      y1="@y"
                      x2="@(SvgWidth - PaddingRight)"
                      y2="@y"
                      stroke="#e5e7eb"
                      stroke-width="1" />
            }

            <!-- Vertical time lines -->
            @for (int i = 0; i < Buckets.Count; i++)
            {
                var x = GetX(i);

                <line x1="@x"
                      y1="@PaddingTop"
                      x2="@x"
                      y2="@(Height - PaddingBottom)"
                      stroke="#f0f0f0"
                      stroke-width="1" />
            }

            <!-- Y-axis labels -->
            @for (int i = 0; i <= YSteps; i++)
            {
                var value = MaxValue - (i * (MaxValue - MinValue) / YSteps);
                var y = GetY(value);

                <foreignObject x="0" y="@(y - 8)" width="36" height="16">
                    <div xmlns="http://www.w3.org/1999/xhtml"
                         style="font-size:10px; color:#374151; text-align:right;">
                        @value.ToString("0")
                    </div>
                </foreignObject>
            }

            <!-- Plot symbols -->
            @for (int i = 0; i < Buckets.Count; i++)
            {
                var bucket = Buckets[i];
                var x = GetX(i);

                @if (bucket.HeartRate.HasValue)
                {
                    var y = GetY(bucket.HeartRate.Value);
                    <line x1="@(x - 6)" y1="@(y - 6)" x2="@(x + 6)" y2="@(y + 6)" stroke="#111827" stroke-width="2" />
                    <line x1="@(x - 6)" y1="@(y + 6)" x2="@(x + 6)" y2="@(y - 6)" stroke="#111827" stroke-width="2" />
                }

                @if (bucket.RespiratoryRate.HasValue)
                {
                    var y = GetY(bucket.RespiratoryRate.Value);
                    <circle cx="@x" cy="@y" r="6" stroke="#2563eb" stroke-width="2" fill="none" />
                }

                @if (bucket.SystolicBp.HasValue)
                {
                    var y = GetY(bucket.SystolicBp.Value);
                    <line x1="@x" y1="@(y + 6)" x2="@x" y2="@(y - 6)" stroke="#dc2626" stroke-width="2" />
                    <line x1="@x" y1="@(y - 6)" x2="@(x - 4)" y2="@(y - 2)" stroke="#dc2626" stroke-width="2" />
                    <line x1="@x" y1="@(y - 6)" x2="@(x + 4)" y2="@(y - 2)" stroke="#dc2626" stroke-width="2" />
                }

                @if (bucket.DiastolicBp.HasValue)
                {
                    var y = GetY(bucket.DiastolicBp.Value);
                    <line x1="@x" y1="@(y - 6)" x2="@x" y2="@(y + 6)" stroke="#16a34a" stroke-width="2" />
                    <line x1="@x" y1="@(y + 6)" x2="@(x - 4)" y2="@(y + 2)" stroke="#16a34a" stroke-width="2" />
                    <line x1="@x" y1="@(y + 6)" x2="@(x + 4)" y2="@(y + 2)" stroke="#16a34a" stroke-width="2" />
                }

                @if (bucket.Map.HasValue)
                {
                    var y = GetY(bucket.Map.Value);
                    <line x1="@(x - 7)" y1="@y" x2="@(x + 7)" y2="@y" stroke="#7c3aed" stroke-width="3" />
                }
            }
        </svg>

        <!-- Time labels under graph -->
        <div style="position:relative; height:28px; width:@SvgWidthPx;">
            @for (int i = 0; i < Buckets.Count; i++)
            {
                var bucket = Buckets[i];
                var left = GetX(i) - 24;
                var isActive = bucket.Id == ActiveBucketId;

                <div style="
                    position:absolute;
                    left:@($"{left}px");
                    width:48px;
                    text-align:center;
                    font-size:10px;
                    color:#374151;
                    font-weight:@(isActive ? "700" : "400");
                    background:@(isActive ? "#fff7cc" : "transparent");
                    border-radius:4px;
                    padding:2px 0;">
                    @bucket.BucketStartTime.ToString("HH:mm")
                </div>
            }
        </div>
    </div>
</div>

<style>
    .graph-legend {
        display: flex;
        flex-wrap: wrap;
        gap: 16px;
        align-items: center;
        margin-bottom: 12px;
        font-size: 14px;
    }

    .legend-item {
        display: flex;
        align-items: center;
        gap: 6px;
        background: #f8fafc;
        border: 1px solid #e5e7eb;
        border-radius: 8px;
        padding: 6px 10px;
    }

    .legend-symbol {
        display: inline-block;
        min-width: 18px;
        text-align: center;
        font-weight: 700;
        font-size: 16px;
    }

    .hr-symbol {
        color: #111827;
    }

    .rr-symbol {
        color: #2563eb;
    }

    .sys-symbol {
        color: #dc2626;
    }

    .dia-symbol {
        color: #16a34a;
    }

    .map-symbol {
        color: #7c3aed;
    }
</style>

@code {
    [Parameter] public List<AnesthesiaBucket> Buckets { get; set; } = new();
    [Parameter] public int Height { get; set; } = 320;
    [Parameter] public double MinValue { get; set; } = 0;
    [Parameter] public double MaxValue { get; set; } = 200;
    [Parameter] public int YSteps { get; set; } = 10;
    [Parameter] public Guid? ActiveBucketId { get; set; }

    private int PaddingLeft => 40;
    private int PaddingRight => 20;
    private int PaddingTop => 20;
    private int PaddingBottom => 20;
    private int ColumnWidth => 70;

    private int SvgWidth => Math.Max(700, PaddingLeft + PaddingRight + Math.Max(1, Buckets.Count) * ColumnWidth);
    private string SvgWidthPx => $"{SvgWidth}px";

    private double PlotHeight => Height - PaddingTop - PaddingBottom;

    private double GetX(int index)
    {
        return PaddingLeft + (index * ColumnWidth) + (ColumnWidth / 2.0);
    }

    private double GetY(double value)
    {
        var clamped = Math.Max(MinValue, Math.Min(MaxValue, value));
        var percent = (clamped - MinValue) / (MaxValue - MinValue);
        return Height - PaddingBottom - (percent * PlotHeight);
    }
}
    }

    private async Task UpdatePdfAttachmentExportLabel(string value)
    {
        _clinicSettings.PdfAttachmentExportLabel = value;
        await SaveClinicSettingsAsync();
    }

    private async Task UpdatePdfAttachmentExportNoteTitle(string value)

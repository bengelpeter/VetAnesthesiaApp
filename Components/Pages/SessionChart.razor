    private async Task ApplyWorkflowTemplate(Guid templateId)
    {
        var template = _workflowTemplates.FirstOrDefault(x => x.Id == templateId);
        if (template is null)
        {
            Snackbar.Add("Workflow template not found.", Severity.Warning);
            return;
        }

        WorkflowTemplateService.ApplyTemplateToSettings(template, _clinicSettings);
        await SaveClinicSettingsAsync();
    }

    private async Task DeleteWorkflowTemplate(Guid templateId)
    {
        await WorkflowTemplateService.DeleteTemplateAsync(templateId);
        await LoadAsync();
        Snackbar.Add("Workflow template deleted.", Severity.Success);
    }

    private async Task UpdateChartFieldLabel(string fieldKey, string? value)
    {
        var labels = ChartConfigurationService.GetLabelMap(_clinicSettings);
        var normalizedValue = string.IsNullOrWhiteSpace(value)
            ? GetDefaultFieldLabel(fieldKey)
            : value.Trim();
        labels[fieldKey] = normalizedValue;
        _clinicSettings.ChartFieldLabelsJson = JsonSerializer.Serialize(labels);
        await SaveClinicSettingsAsync();
    }

    private async Task UpdateRequiredField(string fieldKey, bool isRequired)
    {
        var requiredKeys = new HashSet<string>(
            ChartConfigurationService.GetRequiredCompletionFieldKeys(_clinicSettings),
            StringComparer.OrdinalIgnoreCase);

        if (isRequired)
            requiredKeys.Add(fieldKey);
        else
            requiredKeys.Remove(fieldKey);

        _clinicSettings.RequiredCompletionFieldKeysCsv = string.Join(",",
            _configuredFields
                .Select(x => x.Key)
                .Where(requiredKeys.Contains));

        await SaveClinicSettingsAsync();
    }

    private async Task MoveField(string fieldKey, int direction)
    {
        var orderedKeys = _configuredFields.Select(x => x.Key).ToList();
        var index = orderedKeys.FindIndex(x => string.Equals(x, fieldKey, StringComparison.OrdinalIgnoreCase));
        if (index < 0)
            return;

        var newIndex = index + direction;
        if (newIndex < 0 || newIndex >= orderedKeys.Count)
            return;

        (orderedKeys[index], orderedKeys[newIndex]) = (orderedKeys[newIndex], orderedKeys[index]);
        _clinicSettings.ChartFieldOrderCsv = string.Join(",", orderedKeys);
        await SaveClinicSettingsAsync();
    }

    private bool IsFieldRequired(string fieldKey) =>
        ChartConfigurationService.GetRequiredCompletionFieldKeys(_clinicSettings)
            .Contains(fieldKey, StringComparer.OrdinalIgnoreCase);

    private bool IsFirstField(string fieldKey) =>
        _configuredFields.Count == 0 || string.Equals(_configuredFields[0].Key, fieldKey, StringComparison.OrdinalIgnoreCase);

    private bool IsLastField(string fieldKey) =>
        _configuredFields.Count == 0 || string.Equals(_configuredFields[^1].Key, fieldKey, StringComparison.OrdinalIgnoreCase);

    private int GetFieldPosition(string fieldKey)
    {
        var index = _configuredFields.FindIndex(x => string.Equals(x.Key, fieldKey, StringComparison.OrdinalIgnoreCase));
        return index < 0 ? 0 : index + 1;
    }

    private string GetDefaultFieldLabel(string fieldKey) =>
        ChartConfigurationService.GetLabelMap(new ClinicSettings()).GetValueOrDefault(fieldKey, fieldKey);

    private static decimal? GetBucketFieldValue(AnesthesiaBucket bucket, string fieldKey) =>
        fieldKey switch
        {
            AnesthesiaFieldKeys.IsoPercent => bucket.IsoPercent,
            AnesthesiaFieldKeys.OxygenFlowRate => bucket.OxygenFlowRate,
            AnesthesiaFieldKeys.Etco2 => bucket.Etco2,
            AnesthesiaFieldKeys.Spo2 => bucket.Spo2,
            AnesthesiaFieldKeys.Temperature => bucket.Temperature,
            AnesthesiaFieldKeys.HeartRate => bucket.HeartRate,
            AnesthesiaFieldKeys.RespiratoryRate => bucket.RespiratoryRate,
            AnesthesiaFieldKeys.SystolicBp => bucket.SystolicBp,
            AnesthesiaFieldKeys.DiastolicBp => bucket.DiastolicBp,
            AnesthesiaFieldKeys.Map => bucket.Map,
            _ => null
        };

    private static string FormatTelemetryValue(decimal? value) =>
        value.HasValue ? value.Value.ToString("0.##") : "cleared";

    private string GetTimeToCompletionText() =>
        _telemetrySummary.TimeToCompletion.HasValue
            ? $"{Math.Round(_telemetrySummary.TimeToCompletion.Value.TotalMinutes, 1):0.#} min"
            : "Open";

    private string GetRequiredFieldSummary()
    {
        var requiredKeys = ChartConfigurationService.GetRequiredCompletionFieldKeys(_clinicSettings);
        var labels = _configuredFields
            .Where(x => requiredKeys.Contains(x.Key))
            .Select(x => x.Label)
            .ToList();

        return labels.Count == 0 ? "-" : string.Join(", ", labels);
    }

    private List<string> GetPilotWorkflowItems() =>
        (_clinicSettings.PilotWorkflowNotes ?? string.Empty)
            .Split(['\r', '\n'], StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .ToList();

    private static string DisplayOrDash(string? value) =>
        string.IsNullOrWhiteSpace(value) ? "-" : value.Trim();

    private static string GetTemplateExportTargetLabel(WorkflowTemplate template)
    {
        var settings = new ClinicSettings
        {
            PreferredExportTargetKey = template.PreferredExportTargetKey,
            ClinicChartExportLabel = template.ClinicChartExportLabel,
            ClinicChartExportNoteTitle = template.ClinicChartExportNoteTitle,
            ClinicChartExportDescription = template.ClinicChartExportDescription,
            PdfAttachmentExportLabel = template.PdfAttachmentExportLabel,
            PdfAttachmentExportNoteTitle = template.PdfAttachmentExportNoteTitle,
            PdfAttachmentExportDescription = template.PdfAttachmentExportDescription,
            PdfAttachmentInstruction = template.PdfAttachmentInstruction,
            CurrentSoftwareName = template.CurrentSoftwareName,
            ChartCopyDestination = template.ChartCopyDestination,
            PdfAttachmentDestination = template.PdfAttachmentDestination,
            PreferredNoteWording = template.PreferredNoteWording,
            PilotWorkflowNotes = template.PilotWorkflowNotes
        };

        return ClinicExportTargets.Resolve(settings, settings.PreferredExportTargetKey).Label;
    }
}

@page "/session/{SessionId:guid}"
@implements IAsyncDisposable

@using MudBlazor
@using System.Text.Json
@using VetAnesthesiaApp.Components
@using VetAnesthesiaApp.Models
@using VetAnesthesiaApp.Services.Alerts
@using VetAnesthesiaApp.Services.Data
@using VetAnesthesiaApp.Services.Buckets
@using VetAnesthesiaApp.Services.Pdf
@using VetAnesthesiaApp.Services.Speech
@using VetAnesthesiaApp.Services.Voice
@using VetAnesthesiaApp.Services.Workflow

@inject IAnesthesiaRepository Repository
@inject IBucketService BucketService
@inject NavigationManager Nav
@inject IVetSpeechService SpeechService
@inject IVoiceCommandApplicationService VoiceCommandApplicationService
@inject ISessionAlertEvaluator AlertEvaluator
@inject ISnackbar Snackbar
@inject IVoiceParserService Parser
@inject IPdfSessionExportCoordinator PdfSessionExportCoordinator
@inject IFileShareService FileShareService
@inject ISessionCompletionEvaluator SessionCompletionEvaluator
@inject ISessionHandoffSummaryService SessionHandoffSummaryService
@inject ISessionStructuredExportService SessionStructuredExportService
@inject IClipboardService ClipboardService
@inject IChartConfigurationService ChartConfigurationService
@inject IWorkflowTemplateService WorkflowTemplateService
@inject IWorkflowTelemetryService WorkflowTelemetryService

<PageTitle>Session Chart</PageTitle>

<MudContainer MaxWidth="MaxWidth.False" Class="pa-4">

    @if (_isLoading)
    {
        <MudPaper Class="pa-4">
            <MudText Typo="Typo.h6">Loading session...</MudText>
        </MudPaper>
    }
    else if (_session is null)
    {
        <MudPaper Class="pa-4">
            <MudText Typo="Typo.h6">Session not found.</MudText>

            <MudButton Class="mt-4"
                       Variant="Variant.Filled"
                       Color="Color.Primary"
                       OnClick="GoHome">
                Back to Home
            </MudButton>
        </MudPaper>
    }
    else
    {
        <MudPaper Class="pa-4 mb-4">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                <MudText Typo="Typo.h5">@(_animal?.Name ?? "Unknown Animal")</MudText>
                <MudSpacer />

                <MudButton Variant="Variant.Outlined"
                           OnClick="BackToAnimal">
                    Back
                </MudButton>

                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           OnClick="StartNewBucketNow">
                    New Time Bucket
                </MudButton>

                <MudButton Variant="Variant.Filled"
                           Color="@(_isListening ? Color.Error : Color.Success)"
                           OnClick="ToggleListening">
                    @(_isListening ? "Stop Listening" : "Start Listening")
                </MudButton>

                <MudButton Variant="Variant.Outlined"
                           Color="Color.Warning"
                           Disabled="@(!CanUndoLastVoiceEntry)"
                           OnClick="UndoLastVoiceEntry">
                    Undo Last Voice Entry
                </MudButton>
            </MudStack>

            <MudStack Row="true" Spacing="2" Class="mt-3" Style="flex-wrap:wrap;">
                <MudButton OnClick="ExportPdf"
                           Variant="Variant.Filled"
                           Color="Color.Primary">
                    Export PDF
                </MudButton>

                <MudButton OnClick="CopyHandoffSummary"
                           Variant="Variant.Outlined"
                           Color="Color.Secondary">
                    Copy @SelectedExportTarget.Label
                </MudButton>

                <MudButton OnClick="ShareBucketCsv"
                           Variant="Variant.Outlined"
                           Color="Color.Secondary">
                    Share @GetCsvLabel()
                </MudButton>

                <MudButton OnClick="ToggleSessionComplete"
                           Variant="Variant.Outlined"
                           Color="@(_session.SessionEndTime is null ? Color.Info : Color.Default)">
                    @(_session.SessionEndTime is null ? "Mark Procedure Complete" : "Reopen Procedure")
                </MudButton>
            </MudStack>

            <MudDivider Class="my-3" />

            <MudAlert Severity="@MapSpeechSeverity(_voiceStatusLevel)" Dense="true" Variant="Variant.Filled">
                @_voiceStatus
            </MudAlert>

            <MudAlert Severity="Severity.Info" Dense="true" Class="mt-3">
                If a voice entry is wrong, use <b>Undo Last Voice Entry</b> or tap the chart cell to correct it immediately.
            </MudAlert>

            <MudGrid>
                <MudItem xs="12" sm="6" md="3">
                    <MudText Typo="Typo.caption">Procedure</MudText>
                    <MudTextField T="string"
                                  Value="@_session.Procedure"
                                  ValueChanged="UpdateProcedure"
                                  Immediate="true"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense" />
                </MudItem>

                <MudItem xs="12" sm="6" md="3">
                    <MudText Typo="Typo.caption">Active Bucket</MudText>
                    <MudText Typo="Typo.body1">
                        @(_activeBucket?.BucketStartTime.ToString("hh:mm tt") ?? "None")
                    </MudText>
                </MudItem>

                <MudItem xs="12" sm="6" md="3">
                    <MudText Typo="Typo.caption">Listening</MudText>
                    <MudChip T="string"
                             Color="@(_isListening ? Color.Success : Color.Default)"
                             Variant="Variant.Filled">
                        @(_isListening ? "Listening" : "Off")
                    </MudChip>
                </MudItem>

                <MudItem xs="12" sm="6" md="3">
                    <MudText Typo="Typo.caption">Voice Outcome</MudText>
                    <MudChip T="string"
                             Color="@MapSpeechChipColor(_voiceStatusLevel)"
                             Variant="Variant.Filled">
                        @DescribeVoiceState(_voiceStatusLevel)
                    </MudChip>
                </MudItem>

                <MudItem xs="12" sm="6" md="6">
                    <MudText Typo="Typo.caption">Last Heard</MudText>
                    <MudText Typo="Typo.body2">@_lastSpeech</MudText>
                </MudItem>
            </MudGrid>
        </MudPaper>

        <MudPaper Class="pa-4 mb-4">
            <MudText Typo="Typo.h6" Class="mb-2">VetPulse V2 Settings</MudText>

            <MudGrid>
                <MudItem xs="12" sm="6" md="3">
                    <MudText Typo="Typo.caption">Clinic Name</MudText>
                    <MudTextField T="string"
                                  Value="@_clinicSettings.ClinicName"
                                  ValueChanged="UpdateClinicName"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense" />
                </MudItem>

                <MudItem xs="12" sm="6" md="3">
                    <MudSelect T="string"
                               Label="Primary Export Target"
                               Value="@_clinicSettings.PreferredExportTargetKey"
                               ValueChanged="UpdatePreferredExportTarget"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense">
                        @foreach (var target in AvailableExportTargets)
                        {
                            <MudSelectItem T="string" Value="@target.Key">@target.Label</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>

                <MudItem xs="12" sm="6" md="6">
                    <MudText Typo="Typo.caption">Export Workflow</MudText>
                    <MudText Typo="Typo.body2">@SelectedExportTarget.Description</MudText>
                </MudItem>

                <MudItem xs="12" sm="6" md="3">
                    <MudTextField T="string"
                                  Label="PDF Title"
                                  Value="@_clinicSettings.PdfDocumentTitle"
                                  ValueChanged="UpdatePdfDocumentTitle"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense" />
                </MudItem>

                <MudItem xs="12" sm="6" md="3">
                    <MudTextField T="string"
                                  Label="Chart Note Label"
                                  Value="@_clinicSettings.ClinicChartExportLabel"
                                  ValueChanged="UpdateClinicChartExportLabel"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense" />
                </MudItem>

                <MudItem xs="12" sm="6" md="3">
                    <MudTextField T="string"
                                  Label="Chart Note Title"
                                  Value="@_clinicSettings.ClinicChartExportNoteTitle"
                                  ValueChanged="UpdateClinicChartExportNoteTitle"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense" />
                </MudItem>

                <MudItem xs="12" sm="6" md="3">
                    <MudTextField T="string"
                                  Label="PDF Note Label"
                                  Value="@_clinicSettings.PdfAttachmentExportLabel"
                                  ValueChanged="UpdatePdfAttachmentExportLabel"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense" />
                </MudItem>

                <MudItem xs="12" sm="6" md="3">
                    <MudTextField T="string"
                                  Label="PDF Note Title"
                                  Value="@_clinicSettings.PdfAttachmentExportNoteTitle"
                                  ValueChanged="UpdatePdfAttachmentExportNoteTitle"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense" />
                </MudItem>

                <MudItem xs="12" sm="6" md="3">
                    <MudTextField T="string"
                                  Label="CSV Label"
                                  Value="@_clinicSettings.CsvExportLabel"
                                  ValueChanged="UpdateCsvExportLabel"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense" />
                </MudItem>

                <MudItem xs="12" sm="6" md="3">
                    <MudTextField T="string"
                                  Label="CSV Share Title"
                                  Value="@_clinicSettings.CsvShareTitle"
                                  ValueChanged="UpdateCsvShareTitle"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense" />
                </MudItem>

                <MudItem xs="12">
                    <MudTextField T="string"
                                  Label="Chart Note Description"
                                  Value="@_clinicSettings.ClinicChartExportDescription"
                                  ValueChanged="UpdateClinicChartExportDescription"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense" />
                </MudItem>

                <MudItem xs="12">
                    <MudTextField T="string"
                                  Label="PDF Note Description"
                                  Value="@_clinicSettings.PdfAttachmentExportDescription"
                                  ValueChanged="UpdatePdfAttachmentExportDescription"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense" />
                </MudItem>

                <MudItem xs="12">
                    <MudTextField T="string"
                                  Label="PDF Attachment Instruction"
                                  Value="@_clinicSettings.PdfAttachmentInstruction"
                                  ValueChanged="UpdatePdfAttachmentInstruction"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense" />
                </MudItem>

                <MudItem xs="12" sm="6" md="4">
                    <MudTextField T="string"
                                  Label="Current Clinic Software"
                                  Value="@_clinicSettings.CurrentSoftwareName"
                                  ValueChanged="UpdateCurrentSoftwareName"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense" />
                </MudItem>

                <MudItem xs="12" sm="6" md="4">
                    <MudTextField T="string"
                                  Label="Chart Copy Destination"
                                  Value="@_clinicSettings.ChartCopyDestination"
                                  ValueChanged="UpdateChartCopyDestination"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense" />
                </MudItem>

                <MudItem xs="12" sm="6" md="4">
                    <MudTextField T="string"
                                  Label="PDF Attachment Destination"
                                  Value="@_clinicSettings.PdfAttachmentDestination"
                                  ValueChanged="UpdatePdfAttachmentDestination"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense" />
                </MudItem>

                <MudItem xs="12">
                    <MudTextField T="string"
                                  Label="Preferred Note Wording"
                                  Value="@_clinicSettings.PreferredNoteWording"
                                  ValueChanged="UpdatePreferredNoteWording"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Lines="3" />
                </MudItem>

                <MudItem xs="12">
                    <MudTextField T="string"
                                  Label="Pilot Workflow Notes"
                                  Value="@_clinicSettings.PilotWorkflowNotes"
                                  ValueChanged="UpdatePilotWorkflowNotes"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Lines="4"
                                  HelperText="One workflow reminder per line: what gets copied, attached, checked, or corrected." />
                </MudItem>

                <MudItem xs="12" sm="6" md="3">
                    <MudNumericField T="int"
                                     Label="Monitoring Interval (min)"
                                     Value="@_clinicSettings.MonitoringIntervalMinutes"
                                     ValueChanged="UpdateMonitoringInterval"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense"
                                     HideSpinButtons="true" />
                </MudItem>

                <MudItem xs="12" sm="6" md="3">
                    <MudNumericField T="int"
                                     Label="Missing Vitals Alert (min)"
                                     Value="@_clinicSettings.MissingVitalsAlertAfterMinutes"
                                     ValueChanged="UpdateMissingVitalsThreshold"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense"
                                     HideSpinButtons="true" />
                </MudItem>

                <MudItem xs="12" sm="6" md="3">
                    <MudNumericField T="int"
                                     Label="Low SpO2 Threshold"
                                     Value="@_clinicSettings.Spo2LowThreshold"
                                     ValueChanged="UpdateSpo2Threshold"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense"
                                     HideSpinButtons="true" />
                </MudItem>

                <MudItem xs="12" sm="6" md="3">
                    <MudNumericField T="int"
                                     Label="Low MAP Threshold"
                                     Value="@_clinicSettings.MapLowThreshold"
                                     ValueChanged="UpdateMapThreshold"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense"
                                     HideSpinButtons="true" />
                </MudItem>

                <MudItem xs="12" sm="6" md="3">
                    <MudNumericField T="decimal"
                                     Label="Temp Drop Alert (F)"
                                     Value="@_clinicSettings.TemperatureDropAlertDelta"
                                     ValueChanged="UpdateTemperatureDropThreshold"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense"
                                     HideSpinButtons="true" />
                </MudItem>
            </MudGrid>
        </MudPaper>

        <MudPaper Class="pa-4 mb-4">
            <MudText Typo="Typo.h6" Class="mb-2">Android Pilot Workflow Snapshot</MudText>
            <MudText Typo="Typo.body2" Class="mb-3">
                Use this with your wife during real procedures so the note text and handoff workflow match what her clinic actually needs.
            </MudText>

            <MudGrid>
                <MudItem xs="12" sm="6" md="3">
                    <MudText Typo="Typo.caption">Software</MudText>
                    <MudText Typo="Typo.body1">@DisplayOrDash(_clinicSettings.CurrentSoftwareName)</MudText>
                </MudItem>
                <MudItem xs="12" sm="6" md="3">
                    <MudText Typo="Typo.caption">Copy Destination</MudText>
                    <MudText Typo="Typo.body1">@DisplayOrDash(_clinicSettings.ChartCopyDestination)</MudText>
                </MudItem>
                <MudItem xs="12" sm="6" md="3">
                    <MudText Typo="Typo.caption">PDF Attachment</MudText>
                    <MudText Typo="Typo.body1">@DisplayOrDash(_clinicSettings.PdfAttachmentDestination)</MudText>
                </MudItem>
                <MudItem xs="12" sm="6" md="3">
                    <MudText Typo="Typo.caption">Required Handoff Fields</MudText>
                    <MudText Typo="Typo.body1">@GetRequiredFieldSummary()</MudText>
                </MudItem>
                <MudItem xs="12">
                    <MudText Typo="Typo.caption">Preferred Wording</MudText>
                    <MudText Typo="Typo.body2">@DisplayOrDash(_clinicSettings.PreferredNoteWording)</MudText>
                </MudItem>
                <MudItem xs="12">
                    <MudText Typo="Typo.caption">Workflow Notes</MudText>
                    @if (GetPilotWorkflowItems().Count == 0)
                    {
                        <MudText Typo="Typo.body2">-</MudText>
                    }
                    else
                    {
                        @foreach (var item in GetPilotWorkflowItems())
                        {
                            <MudText Typo="Typo.body2">- @item</MudText>
                        }
                    }
                </MudItem>
            </MudGrid>
        </MudPaper>

        <MudPaper Class="pa-4 mb-4">
            <MudText Typo="Typo.h6" Class="mb-2">Workflow Templates</MudText>

            <MudGrid>
                <MudItem xs="12" md="4">
                    <MudTextField T="string"
                                  Label="Template Name"
                                  Value="@_newTemplateName"
                                  ValueChanged="@(value => _newTemplateName = value)"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense" />
                </MudItem>

                <MudItem xs="12" md="6">
                    <MudTextField T="string"
                                  Label="Template Description"
                                  Value="@_newTemplateDescription"
                                  ValueChanged="@(value => _newTemplateDescription = value)"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense" />
                </MudItem>

                <MudItem xs="12" md="2" Class="d-flex align-center">
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               Disabled="@string.IsNullOrWhiteSpace(_newTemplateName)"
                               OnClick="SaveCurrentWorkflowTemplate">
                        Save Current Template
                    </MudButton>
                </MudItem>
            </MudGrid>

            @if (_workflowTemplates.Count == 0)
            {
                <MudAlert Severity="Severity.Info" Dense="true" Class="mt-3">
                    No clinic workflow templates saved yet.
                </MudAlert>
            }
            else
            {
                <MudTable Items="_workflowTemplates" Dense="true" Hover="true" Bordered="true" Class="mt-3">
                    <HeaderContent>
                        <MudTh>Name</MudTh>
                        <MudTh>Description</MudTh>
                        <MudTh>Export Target</MudTh>
                        <MudTh>Actions</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Name">@context.Name</MudTd>
                        <MudTd DataLabel="Description">@(string.IsNullOrWhiteSpace(context.Description) ? "-" : context.Description)</MudTd>
                        <MudTd DataLabel="Export Target">@GetTemplateExportTargetLabel(context)</MudTd>
                        <MudTd DataLabel="Actions">
                            <MudButton Variant="Variant.Text"
                                       Color="Color.Primary"
                                       OnClick="@(async () => await ApplyWorkflowTemplate(context.Id))">
                                Apply
                            </MudButton>
                            <MudButton Variant="Variant.Text"
                                       Color="Color.Error"
                                       OnClick="@(async () => await DeleteWorkflowTemplate(context.Id))">
                                Delete
                            </MudButton>
                        </MudTd>
                    </RowTemplate>
                </MudTable>
            }
        </MudPaper>

        <MudPaper Class="pa-4 mb-4">
            <MudText Typo="Typo.h6" Class="mb-2">Chart Labels And Completion Rules</MudText>
            <MudText Typo="Typo.body2" Class="mb-2">
                Rename chart labels, change row order, and decide which vitals must be present before the case is considered handoff-ready.
            </MudText>

            <MudTable Items="_configuredFields" Dense="true" Hover="true" Bordered="true">
                <HeaderContent>
                    <MudTh>Order</MudTh>
                    <MudTh>Field Key</MudTh>
                    <MudTh>Clinic Label</MudTh>
                    <MudTh>Required</MudTh>
                    <MudTh>Move</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Order">@GetFieldPosition(context.Key)</MudTd>
                    <MudTd DataLabel="Field Key">@context.Key</MudTd>
                    <MudTd DataLabel="Clinic Label">
                        <MudTextField T="string"
                                      Value="@context.Label"
                                      ValueChanged="@(async value => await UpdateChartFieldLabel(context.Key, value))"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense" />
                    </MudTd>
                    <MudTd DataLabel="Required">
                        <MudCheckBox T="bool"
                                     Value="@IsFieldRequired(context.Key)"
                                     ValueChanged="@(async value => await UpdateRequiredField(context.Key, value))"
                                     Color="Color.Primary" />
                    </MudTd>
                    <MudTd DataLabel="Move">
                        <MudButton Variant="Variant.Text"
                                   Disabled="@IsFirstField(context.Key)"
                                   OnClick="@(async () => await MoveField(context.Key, -1))">
                            Up
                        </MudButton>
                        <MudButton Variant="Variant.Text"
                                   Disabled="@IsLastField(context.Key)"
                                   OnClick="@(async () => await MoveField(context.Key, 1))">
                            Down
                        </MudButton>
                    </MudTd>
                </RowTemplate>
            </MudTable>
        </MudPaper>

        <MudPaper Class="pa-4 mb-4">
            <MudText Typo="Typo.h6" Class="mb-2">Safety Alerts</MudText>

            @if (_alerts.Count == 0)
            {
                <MudAlert Severity="Severity.Success" Dense="true">
                    No active safety alerts right now.
                </MudAlert>
            }
            else
            {
                @foreach (var alert in _alerts)
                {
                    <MudAlert Severity="@MapAlertSeverity(alert.Level)" Dense="true" Class="mb-2">
                        @alert.Message
                    </MudAlert>
                }
            }
        </MudPaper>

        <MudPaper Class="pa-4 mb-4">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                <MudText Typo="Typo.h6">Completion Checks</MudText>
                <MudSpacer />
                <MudChip T="string"
                         Color="@(_completionSummary.IsReadyForHandoff ? Color.Success : Color.Warning)"
                         Variant="Variant.Filled">
                    @(_completionSummary.IsReadyForHandoff ? "Ready for handoff" : "Needs attention")
                </MudChip>
            </MudStack>

            <MudGrid Class="mt-2">
                @foreach (var item in _completionSummary.Items)
                {
                    <MudItem xs="12" md="6">
                        <MudAlert Severity="@MapCompletionSeverity(item)" Dense="true" Class="mb-2">
                            <b>@item.Label:</b> @item.Message
                        </MudAlert>
                    </MudItem>
                }
            </MudGrid>
        </MudPaper>

        <MudPaper Class="pa-4 mb-4">
            <MudText Typo="Typo.h6" Class="mb-2">Voice Debug</MudText>

            <MudGrid>
                <MudItem xs="12">
                    <MudText Typo="Typo.caption">Last Heard</MudText>
                    <MudText Typo="Typo.body1">@_lastSpeech</MudText>
                </MudItem>

                <MudItem xs="12">
                    <MudText Typo="Typo.caption">Normalized</MudText>
                    <MudText Typo="Typo.body1">@_debugNormalized</MudText>
                </MudItem>

                <MudItem xs="12" sm="6" md="3">
                    <MudText Typo="Typo.caption">Field</MudText>
                    <MudText Typo="Typo.body1">@_debugField</MudText>
                </MudItem>

                <MudItem xs="12" sm="6" md="3">
                    <MudText Typo="Typo.caption">Value Text</MudText>
                    <MudText Typo="Typo.body1">@_debugValueText</MudText>
                </MudItem>

                <MudItem xs="12" sm="6" md="3">
                    <MudText Typo="Typo.caption">Numeric</MudText>
                    <MudText Typo="Typo.body1">@_debugNumeric</MudText>
                </MudItem>

                <MudItem xs="12" sm="6" md="3">
                    <MudText Typo="Typo.caption">Status</MudText>
                    <MudText Typo="Typo.body1">@_debugStatus</MudText>
                </MudItem>
            </MudGrid>
        </MudPaper>

        <MudPaper Class="pa-4 mb-4">
            <MudText Typo="Typo.h6" Class="mb-2">Workflow Telemetry</MudText>

            <MudGrid>
                <MudItem xs="12" sm="6" md="2">
                    <MudText Typo="Typo.caption">Voice Attempts</MudText>
                    <MudText Typo="Typo.h6">@_telemetrySummary.VoiceAttempts</MudText>
                </MudItem>
                <MudItem xs="12" sm="6" md="2">
                    <MudText Typo="Typo.caption">Failed Voice</MudText>
                    <MudText Typo="Typo.h6">@_telemetrySummary.FailedVoiceAttempts</MudText>
                </MudItem>
                <MudItem xs="12" sm="6" md="2">
                    <MudText Typo="Typo.caption">Undo Usage</MudText>
                    <MudText Typo="Typo.h6">@_telemetrySummary.UndoUsage</MudText>
                </MudItem>
                <MudItem xs="12" sm="6" md="2">
                    <MudText Typo="Typo.caption">Manual Corrections</MudText>
                    <MudText Typo="Typo.h6">@_telemetrySummary.ManualCorrections</MudText>
                </MudItem>
                <MudItem xs="12" sm="6" md="2">
                    <MudText Typo="Typo.caption">Completion Changes</MudText>
                    <MudText Typo="Typo.h6">@_telemetrySummary.CompletionEvents</MudText>
                </MudItem>
                <MudItem xs="12" sm="6" md="2">
                    <MudText Typo="Typo.caption">Time To Completion</MudText>
                    <MudText Typo="Typo.h6">@GetTimeToCompletionText()</MudText>
                </MudItem>
            </MudGrid>
        </MudPaper>

        <MudPaper Class="pa-4 mb-4">
            <MudText Typo="Typo.h6" Class="mb-2">Procedure Notes</MudText>

            @if (_noteEntries.Count == 0)
            {
                <MudAlert Severity="Severity.Info" Dense="true">
                    No bucket notes recorded yet.
                </MudAlert>
            }
            else
            {
                @foreach (var note in _noteEntries)
                {
                    <MudPaper Class="pa-3 mb-2">
                        <MudText Typo="Typo.subtitle2">@note.BucketStartTime.ToString("hh:mm tt")</MudText>
                        <MudText Typo="Typo.body2">@note.Notes</MudText>
                    </MudPaper>
                }
            }
        </MudPaper>

        <MudPaper Class="pa-4 mb-4">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                <MudText Typo="Typo.h6">@SelectedExportTarget.Label</MudText>
                <MudSpacer />
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Secondary"
                           OnClick="CopyHandoffSummary">
                    Copy @SelectedExportTarget.Label
                </MudButton>

                <MudButton Variant="Variant.Outlined"
                           Color="Color.Secondary"
                           OnClick="ShareBucketCsv">
                    Share @GetCsvLabel()
                </MudButton>
            </MudStack>

            <MudText Typo="Typo.body2" Class="mb-2">
                @SelectedExportTarget.Description
            </MudText>

            <MudTextField T="string"
                          Value="@_handoffSummary"
                          ReadOnly="true"
                          Lines="14"
                          Variant="Variant.Outlined"
                          FullWidth="true" />
        </MudPaper>

        <MudPaper Class="pa-4 mb-4">
            <MudText Typo="Typo.h6" Class="mb-2">Recent Voice Activity</MudText>

            @if (_recentVoiceLogs.Count == 0)
            {
                <MudAlert Severity="Severity.Info" Dense="true">
                    No voice attempts logged yet.
                </MudAlert>
            }
            else
            {
                <MudTable Items="_recentVoiceLogs" Dense="true" Hover="true" Bordered="true" Striped="true">
                    <HeaderContent>
                        <MudTh>Time</MudTh>
                        <MudTh>Transcript</MudTh>
                        <MudTh>Status</MudTh>
                        <MudTh>Outcome</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Time">@context.SpokenAt.ToString("hh:mm:ss tt")</MudTd>
                        <MudTd DataLabel="Transcript">@context.RawTranscript</MudTd>
                        <MudTd DataLabel="Status">@context.StatusMessage</MudTd>
                        <MudTd DataLabel="Outcome">
                            <MudChip T="string"
                                     Color="@MapVoiceLogColor(context)"
                                     Variant="Variant.Filled">
                                @DescribeVoiceLogOutcome(context)
                            </MudChip>
                        </MudTd>
                    </RowTemplate>
                </MudTable>
            }
        </MudPaper>

        <MudPaper Class="pa-4">
            <MudText Typo="Typo.h6" Class="mb-3">Anesthesia Chart</MudText>

            @if (_buckets.Count == 0)
            {
                <MudAlert Severity="Severity.Info" Dense="true">
                    No time buckets yet. Tap <b>New Time Bucket</b> to begin charting.
                </MudAlert>
            }
            else
            {
                <div style="overflow-x:auto;">
                    <table class="session-grid">
                        <thead>
                            <tr>
                                <th class="sticky-col field-col">Field</th>

                                @foreach (var bucket in _buckets)
                                {
                                    <th class="time-col @(bucket.Id == _activeBucket?.Id ? "active-bucket-col" : "")">
                                        @bucket.BucketStartTime.ToString("hh:mm tt")
                                    </th>
                                }
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var field in _configuredFields)
                            {
                                <tr>
                                    <td class="sticky-col field-col">@field.Label</td>
                                    @foreach (var bucket in _buckets)
                                    {
                                        <td class="@(bucket.Id == _activeBucket?.Id ? "active-bucket-col" : "")">
                                            <MudNumericField T="decimal?"
                                                             Value="@field.ValueSelector(bucket)"
                                                             ValueChanged="@(async value => await UpdateConfiguredField(bucket, field.Key, value))"
                                                             Immediate="true"
                                                             Variant="Variant.Outlined"
                                                             Margin="Margin.Dense"
                                                             HideSpinButtons="true"
                                                             Step="@(field.IsWholeNumber ? 1m : 0.1m)" />
                                        </td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </MudPaper>

        <MudDivider Class="my-4" />

        <MudText Typo="Typo.h6" Class="mb-3">Vitals Trend</MudText>

        @if (_buckets.Count > 0)
        {
            <AnesthesiaPointGraph Buckets="_buckets"
                                  ActiveBucketId="_activeBucket?.Id"
                                  Height="320"
                                  MinValue="0"
                                  MaxValue="200"
                                  YSteps="10" />
        }
        else
        {
            <MudAlert Severity="Severity.Info" Dense="true">
                Add at least one bucket to see the trend chart.
            </MudAlert>
        }
    }

</MudContainer>

<style>

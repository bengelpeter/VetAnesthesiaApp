@page "/session/{SessionId:guid}"
@implements IAsyncDisposable

@using MudBlazor
@using VetAnesthesiaApp.Components
@using VetAnesthesiaApp.Models
@using VetAnesthesiaApp.Services.Alerts
@using VetAnesthesiaApp.Services.Data
@using VetAnesthesiaApp.Services.Buckets
@using VetAnesthesiaApp.Services.Pdf
@using VetAnesthesiaApp.Services.Speech
@using VetAnesthesiaApp.Services.Voice
@using VetAnesthesiaApp.Services.Workflow

@inject IAnesthesiaRepository Repository
@inject IBucketService BucketService
@inject NavigationManager Nav
@inject IVetSpeechService SpeechService
@inject IVoiceCommandApplicationService VoiceCommandApplicationService
@inject ISessionAlertEvaluator AlertEvaluator
@inject ISnackbar Snackbar
@inject IVoiceParserService Parser
@inject IPdfSessionExportCoordinator PdfSessionExportCoordinator
@inject IFileShareService FileShareService
@inject ISessionCompletionEvaluator SessionCompletionEvaluator
@inject ISessionHandoffSummaryService SessionHandoffSummaryService
@inject ISessionStructuredExportService SessionStructuredExportService
@inject IClipboardService ClipboardService
@inject IChartConfigurationService ChartConfigurationService
@inject IWorkflowTelemetryService WorkflowTelemetryService

<PageTitle>Session Chart</PageTitle>

<MudContainer MaxWidth="MaxWidth.False" Class="pa-4">

    @if (_isLoading)
    {
        <MudPaper Class="pa-4">
            <MudText Typo="Typo.h6">Loading session...</MudText>
        </MudPaper>
    }
    else if (_session is null)
    {
        <MudPaper Class="pa-4">
            <MudText Typo="Typo.h6">Session not found.</MudText>

            <MudButton Class="mt-4"
                       Variant="Variant.Filled"
                       Color="Color.Primary"
                       OnClick="GoHome">
                Back to Home
            </MudButton>
        </MudPaper>
    }
    else
    {
        <MudPaper Class="pa-5 mb-4 case-hero">
            <MudStack Row="true" AlignItems="AlignItems.Start" Justify="Justify.SpaceBetween" Style="flex-wrap:wrap;" Spacing="2">
                <div>
                    <MudText Typo="Typo.h4">@(_animal?.Name ?? "Unknown Animal")</MudText>
                    <MudStack Row="true" Spacing="1" Class="mt-2" Style="flex-wrap:wrap;">
                        <MudChip T="string" Variant="Variant.Outlined" Color="Color.Default">
                            @(_animal?.Species ?? "Species not set")
                        </MudChip>
                        @if (!string.IsNullOrWhiteSpace(_animal?.OwnerName))
                        {
                            <MudChip T="string" Variant="Variant.Outlined" Color="Color.Default">
                                Owner: @_animal!.OwnerName
                            </MudChip>
                        }
                        <MudChip T="string"
                                 Variant="Variant.Filled"
                                 Color="@(_session.SessionEndTime is null ? Color.Info : Color.Success)">
                            @(_session.SessionEndTime is null ? "Case in progress" : "Procedure complete")
                        </MudChip>
                    </MudStack>
                </div>

                <MudStack Row="true" Spacing="1" Style="flex-wrap:wrap;">
                    <MudButton Variant="Variant.Outlined" OnClick="BackToAnimal">
                        Back
                    </MudButton>
                    <MudButton Variant="Variant.Text" Color="Color.Secondary" OnClick="GoToWorkflowSetup">
                        Workflow Setup
                    </MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="StartNewBucketNow">
                        New Time Bucket
                    </MudButton>
                    <MudButton Variant="Variant.Filled"
                               Color="@(_isListening ? Color.Error : Color.Success)"
                               OnClick="ToggleListening">
                        @(_isListening ? "Stop Listening" : "Start Listening")
                    </MudButton>
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Warning"
                               Disabled="@(!CanUndoLastVoiceEntry)"
                               OnClick="UndoLastVoiceEntry">
                        Undo
                    </MudButton>
                </MudStack>
            </MudStack>

            <MudGrid Spacing="2" Class="mt-4">
                <MudItem xs="12" md="4">
                    <MudPaper Class="pa-3 case-stat">
                        <MudText Typo="Typo.caption">Procedure</MudText>
                        <MudTextField T="string"
                                      Value="@_session.Procedure"
                                      ValueChanged="UpdateProcedure"
                                      Immediate="true"
                                      Placeholder="Enter procedure"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense" />
                    </MudPaper>
                </MudItem>
                <MudItem xs="6" md="2">
                    <MudPaper Class="pa-3 case-stat">
                        <MudText Typo="Typo.caption">Active Bucket</MudText>
                        <MudText Typo="Typo.h6">@(_activeBucket?.BucketStartTime.ToString("hh:mm tt") ?? "None")</MudText>
                    </MudPaper>
                </MudItem>
                <MudItem xs="6" md="2">
                    <MudPaper Class="pa-3 case-stat">
                        <MudText Typo="Typo.caption">Listening</MudText>
                        <MudChip T="string"
                                 Color="@(_isListening ? Color.Success : Color.Default)"
                                 Variant="Variant.Filled"
                                 Size="Size.Small">
                            @(_isListening ? "Live" : "Off")
                        </MudChip>
                    </MudPaper>
                </MudItem>
                <MudItem xs="6" md="2">
                    <MudPaper Class="pa-3 case-stat">
                        <MudText Typo="Typo.caption">Voice Status</MudText>
                        <MudChip T="string"
                                 Color="@MapSpeechChipColor(_voiceStatusLevel)"
                                 Variant="Variant.Filled"
                                 Size="Size.Small">
                            @DescribeVoiceState(_voiceStatusLevel)
                        </MudChip>
                    </MudPaper>
                </MudItem>
                <MudItem xs="6" md="2">
                    <MudPaper Class="pa-3 case-stat">
                        <MudText Typo="Typo.caption">Buckets</MudText>
                        <MudText Typo="Typo.h6">@_buckets.Count</MudText>
                    </MudPaper>
                </MudItem>
                <MudItem xs="12">
                    <MudAlert Severity="@MapSpeechSeverity(_voiceStatusLevel)" Dense="true" Variant="Variant.Filled">
                        @_voiceStatus
                    </MudAlert>
                </MudItem>
                <MudItem xs="12">
                    <MudText Typo="Typo.caption">Last Heard</MudText>
                    <MudText Typo="Typo.body2">@_lastSpeech</MudText>
                </MudItem>
            </MudGrid>
        </MudPaper>

        <MudGrid Spacing="3">
            <MudItem xs="12" lg="8">
                <MudPaper Class="pa-4 mb-4 chart-shell">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Style="flex-wrap:wrap;">
                        <div>
                            <MudText Typo="Typo.h5">Live Anesthesia Chart</MudText>
                            <MudText Typo="Typo.body2">
                                Enter values by voice or tap directly into the active bucket.
                            </MudText>
                        </div>
                        <MudSpacer />
                        <MudButton OnClick="ToggleSessionComplete"
                                   Variant="Variant.Outlined"
                                   Color="@(_session.SessionEndTime is null ? Color.Info : Color.Default)">
                            @(_session.SessionEndTime is null ? "Mark Procedure Complete" : "Reopen Procedure")
                        </MudButton>
                    </MudStack>

                    @if (_buckets.Count == 0)
                    {
                        <MudAlert Severity="Severity.Info" Dense="true" Class="mt-4">
                            No time buckets yet. Tap <b>New Time Bucket</b> to begin charting.
                        </MudAlert>
                    }
                    else
                    {
                        <div class="chart-scroll mt-4">
                            <table class="session-grid">
                                <thead>
                                    <tr>
                                        <th class="sticky-col field-col">Field</th>

                                        @foreach (var bucket in _buckets)
                                        {
                                            <th class="time-col @(bucket.Id == _activeBucket?.Id ? "active-bucket-col" : "")">
                                                @bucket.BucketStartTime.ToString("hh:mm tt")
                                            </th>
                                        }
                                    </tr>
                                </thead>

                                <tbody>
                                    @foreach (var field in _configuredFields)
                                    {
                                        <tr>
                                            <td class="sticky-col field-col">@field.Label</td>
                                            @foreach (var bucket in _buckets)
                                            {
                                                <td class="@(bucket.Id == _activeBucket?.Id ? "active-bucket-col" : "")">
                                                    <MudNumericField T="decimal?"
                                                                     Value="@field.ValueSelector(bucket)"
                                                                     ValueChanged="@(async value => await UpdateConfiguredField(bucket, field.Key, value))"
                                                                     Immediate="true"
                                                                     Variant="Variant.Outlined"
                                                                     Margin="Margin.Dense"
                                                                     HideSpinButtons="true"
                                                                     Step="@(field.IsWholeNumber ? 1m : 0.1m)" />
                                                </td>
                                            }
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <MudDivider Class="my-4" />

                        <MudText Typo="Typo.h6" Class="mb-2">Trend View</MudText>
                        <AnesthesiaPointGraph Buckets="_buckets"
                                              ActiveBucketId="_activeBucket?.Id"
                                              Height="320"
                                              MinValue="0"
                                              MaxValue="200"
                                              YSteps="10" />
                    }
                </MudPaper>
            </MudItem>

            <MudItem xs="12" lg="4">
                <MudPaper Class="pa-4 mb-4 side-panel">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                        <MudText Typo="Typo.h6">Safety Alerts</MudText>
                        <MudSpacer />
                        <MudChip T="string"
                                 Variant="Variant.Filled"
                                 Color="@(_alerts.Count == 0 ? Color.Success : Color.Warning)"
                                 Size="Size.Small">
                            @(_alerts.Count == 0 ? "Stable" : $"{_alerts.Count} active")
                        </MudChip>
                    </MudStack>

                    @if (_alerts.Count == 0)
                    {
                        <MudAlert Severity="Severity.Success" Dense="true" Class="mt-3">
                            No active safety alerts right now.
                        </MudAlert>
                    }
                    else
                    {
                        <div class="mt-3">
                            @foreach (var alert in _alerts)
                            {
                                <MudAlert Severity="@MapAlertSeverity(alert.Level)" Dense="true" Class="mb-2">
                                    @alert.Message
                                </MudAlert>
                            }
                        </div>
                    }
                </MudPaper>

                <MudPaper Class="pa-4 mb-4 side-panel">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                        <MudText Typo="Typo.h6">Handoff Readiness</MudText>
                        <MudSpacer />
                        <MudChip T="string"
                                 Color="@(_completionSummary.IsReadyForHandoff ? Color.Success : Color.Warning)"
                                 Variant="Variant.Filled"
                                 Size="Size.Small">
                            @(_completionSummary.IsReadyForHandoff ? "Ready" : "Needs review")
                        </MudChip>
                    </MudStack>

                    <div class="mt-3">
                        @foreach (var item in _completionSummary.Items)
                        {
                            <MudAlert Severity="@MapCompletionSeverity(item)" Dense="true" Class="mb-2">
                                <b>@item.Label:</b> @item.Message
                            </MudAlert>
                        }
                    </div>
                </MudPaper>

                <MudPaper Class="pa-4 mb-4 side-panel">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Style="flex-wrap:wrap;">
                        <MudText Typo="Typo.h6">@SelectedExportTarget.Label</MudText>
                        <MudSpacer />
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="ExportPdf">
                            Export PDF
                        </MudButton>
                    </MudStack>

                    <MudText Typo="Typo.body2" Class="mt-2 mb-3">
                        @SelectedExportTarget.Description
                    </MudText>

                    <MudStack Row="true" Spacing="1" Style="flex-wrap:wrap;" Class="mb-3">
                        <MudButton Variant="Variant.Outlined" Color="Color.Secondary" OnClick="CopyHandoffSummary">
                            Copy Note
                        </MudButton>
                        <MudButton Variant="Variant.Outlined" Color="Color.Secondary" OnClick="ShareBucketCsv">
                            Share CSV
                        </MudButton>
                    </MudStack>

                    <MudTextField T="string"
                                  Value="@_handoffSummary"
                                  ReadOnly="true"
                                  Lines="14"
                                  Variant="Variant.Outlined"
                                  FullWidth="true" />
                </MudPaper>

                <MudExpansionPanels MultiExpansion="true">
                    <MudExpansionPanel Text="Procedure Notes" Expanded="@(_noteEntries.Count > 0)">
                        @if (_noteEntries.Count == 0)
                        {
                            <MudAlert Severity="Severity.Info" Dense="true">
                                No bucket notes recorded yet.
                            </MudAlert>
                        }
                        else
                        {
                            @foreach (var note in _noteEntries)
                            {
                                <MudPaper Class="pa-3 mb-2 note-card">
                                    <MudText Typo="Typo.subtitle2">@note.BucketStartTime.ToString("hh:mm tt")</MudText>
                                    <MudText Typo="Typo.body2">@note.Notes</MudText>
                                </MudPaper>
                            }
                        }
                    </MudExpansionPanel>

                    <MudExpansionPanel Text="Recent Voice Activity">
                        @if (_recentVoiceLogs.Count == 0)
                        {
                            <MudAlert Severity="Severity.Info" Dense="true">
                                No voice attempts logged yet.
                            </MudAlert>
                        }
                        else
                        {
                            <MudTable Items="_recentVoiceLogs" Dense="true" Hover="true" Bordered="true">
                                <HeaderContent>
                                    <MudTh>Time</MudTh>
                                    <MudTh>Status</MudTh>
                                    <MudTh>Outcome</MudTh>
                                </HeaderContent>
                                <RowTemplate>
                                    <MudTd DataLabel="Time">@context.SpokenAt.ToString("hh:mm:ss tt")</MudTd>
                                    <MudTd DataLabel="Status">@context.StatusMessage</MudTd>
                                    <MudTd DataLabel="Outcome">
                                        <MudChip T="string"
                                                 Color="@MapVoiceLogColor(context)"
                                                 Variant="Variant.Filled"
                                                 Size="Size.Small">
                                            @DescribeVoiceLogOutcome(context)
                                        </MudChip>
                                    </MudTd>
                                </RowTemplate>
                            </MudTable>
                        }
                    </MudExpansionPanel>
                </MudExpansionPanels>
            </MudItem>
        </MudGrid>
    }

</MudContainer>

<style>
    .case-hero {
        background: linear-gradient(135deg, #f7fbff 0%, #ffffff 100%);
        border: 1px solid #d9e4f0;
        box-shadow: 0 10px 24px rgba(23, 50, 77, 0.06);
    }

    .case-stat {
        height: 100%;
        border: 1px solid #dfe7f0;
        background: #fbfdff;
    }

    .chart-shell,
    .side-panel {
        border: 1px solid #dfe7f0;
        box-shadow: 0 8px 18px rgba(23, 50, 77, 0.04);
    }

    .chart-scroll {
        overflow-x: auto;
        border: 1px solid #dfe7f0;
        border-radius: 12px;
        background: #fff;
    }

    .note-card {
        border: 1px solid #e1e8f0;
        background: #fbfdff;
    }

    .session-grid {
        border-collapse: collapse;
        min-width: 1050px;
        width: 100%;
        background: white;
    }

        .session-grid th,
        .session-grid td {
            border: 1px solid #dcdcdc;
            padding: 8px;
            text-align: center;
            vertical-align: middle;
            min-width: 120px;
        }

        .session-grid thead th {
            background: #f5f7fb;
            font-weight: 600;
            position: sticky;
            top: 0;
            z-index: 2;
        }

    .field-col {
        min-width: 90px !important;
        font-weight: 600;
        background: #f9fafb;
        text-align: left !important;
    }

    .sticky-col {
        position: sticky;
        left: 0;
        z-index: 1;
        background: #f9fafb;
    }

    .session-grid thead .sticky-col {
        z-index: 3;
        background: #eef3fb;
    }

    .time-col {
        min-width: 125px;
    }

    .active-bucket-col {
        background-color: #eef7ff !important;
    }
</style>

@code {
    [Parameter] public Guid SessionId { get; set; }

    private AnesthesiaSession? _session;
    private Animal? _animal;
    private List<AnesthesiaBucket> _buckets = new();
    private AnesthesiaBucket? _activeBucket;
    private List<VoiceEntryLog> _recentVoiceLogs = new();
    private List<AnesthesiaBucket> _noteEntries = new();
    private List<SessionAlert> _alerts = new();
    private List<ChartFieldDefinition> _configuredFields = new();
    private SessionCompletionSummary _completionSummary = new(Array.Empty<SessionCompletionItem>());
    private ClinicSettings _clinicSettings = new();
    private bool _isLoading = true;
    private bool _isListening;
    private bool _isDisposed;
    private string _lastSpeech = "-";
    private string _voiceStatus = "-";
    private string _handoffSummary = "";
    private string _debugStatus = "-";
    private SpeechStatusLevel _voiceStatusLevel = SpeechStatusLevel.Info;

    private IReadOnlyList<ClinicExportTargetOption> AvailableExportTargets => ClinicExportTargets.BuildOptions(_clinicSettings);

    private ClinicExportTargetOption SelectedExportTarget => ClinicExportTargets.Resolve(_clinicSettings, _clinicSettings.PreferredExportTargetKey);

    protected override async Task OnInitializedAsync()
    {
        await Repository.InitializeAsync();

        SpeechService.SpeechRecognized += OnSpeechRecognized;
        SpeechService.ListeningChanged += OnListeningChanged;
        SpeechService.StatusChanged += OnSpeechStatusChanged;

        await LoadAsync();
    }

    private async Task ExportPdf()
    {
        try
        {
            var result = await PdfSessionExportCoordinator.ExportAndShareAsync(SessionId);

            if (result.ShareRequested)
            {
                Snackbar.Add("PDF generated and ready to share.", Severity.Success);
                return;
            }

            Snackbar.Add(
                $"PDF generated, but the share sheet could not open. File saved to {result.FilePath}",
                Severity.Warning);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"PDF export failed: {ex.Message}", Severity.Error);
        }
    }

    private async Task LoadAsync()
    {
        _session = await Repository.GetSessionAsync(SessionId);

        if (_session is null)
        {
            _animal = null;
            _buckets = new();
            _activeBucket = null;
            _recentVoiceLogs = new();
            _noteEntries = new();
            _configuredFields = new();
            _completionSummary = new SessionCompletionSummary(Array.Empty<SessionCompletionItem>());
            _handoffSummary = string.Empty;
            _isLoading = false;
            await InvokeAsync(StateHasChanged);
            return;
        }

        _animal = await Repository.GetAnimalAsync(_session.AnimalId);
        _clinicSettings = await Repository.GetClinicSettingsAsync();
        _configuredFields = ChartConfigurationService.GetConfiguredFields(_clinicSettings).ToList();
        _buckets = await Repository.GetBucketsAsync(SessionId);
        _activeBucket = await BucketService.GetActiveBucketAsync(SessionId);
        _recentVoiceLogs = (await Repository.GetVoiceLogsAsync(SessionId))
            .Take(8)
            .ToList();
        _noteEntries = _buckets
            .Where(x => !string.IsNullOrWhiteSpace(x.Notes))
            .OrderByDescending(x => x.BucketStartTime)
            .ToList();
        _alerts = AlertEvaluator.Evaluate(_buckets, _clinicSettings, DateTime.Now);
        _completionSummary = SessionCompletionEvaluator.Evaluate(_session, _buckets, _clinicSettings, _recentVoiceLogs, DateTime.Now);
        _handoffSummary = SessionHandoffSummaryService.Build(_animal, _session, _clinicSettings, _buckets, _alerts, _completionSummary);

        _isLoading = false;
        await InvokeAsync(StateHasChanged);
    }

    private void GoHome()
    {
        Nav.NavigateTo("/");
    }

    private void BackToAnimal()
    {
        if (_session is not null)
            Nav.NavigateTo($"/animal/{_session.AnimalId}");
        else
            Nav.NavigateTo("/");
    }

    private void GoToWorkflowSetup()
    {
        Nav.NavigateTo("/workflow-setup");
    }

    private async Task StartNewBucketNow()
    {
        await BucketService.StartNewBucketAsync(SessionId, DateTime.Now);
        await LoadAsync();
    }

    private async Task ToggleListening()
    {
        try
        {
            if (_isListening)
            {
                await SpeechService.StopAsync();
                _debugStatus = "Stopped listening.";
            }
            else
            {
                await SpeechService.StartAsync();
            }
        }
        catch (Exception ex)
        {
            _debugStatus = ex.Message;
            Snackbar.Add($"Voice start failed: {ex.Message}", Severity.Error);
        }

        await InvokeAsync(StateHasChanged);
    }

    private async void OnSpeechRecognized(string text)
    {
        if (_isDisposed)
            return;

        _lastSpeech = text;
        SetVoiceStatus(SpeechStatusLevel.Info, "Processing captured speech...");

        var spokenAt = DateTime.Now;
        var commands = VoiceTranscriptSegmenter.Split(text);
        var appliedCount = 0;
        var failedMessages = new List<string>();

        foreach (var command in commands)
        {
            var parseResult = Parser.Parse(command, spokenAt);
            _debugStatus = parseResult.StatusMessage ?? "-";

            try
            {
                var log = await VoiceCommandApplicationService.ProcessTranscriptAsync(SessionId, command, spokenAt);

                if (log.Applied)
                {
                    appliedCount++;
                }
                else
                {
                    failedMessages.Add($"{command}: {log.StatusMessage}");
                    Snackbar.Add($"Voice command not applied: {log.StatusMessage}", Severity.Warning);
                }
            }
            catch (Exception ex)
            {
                failedMessages.Add($"{command}: {ex.Message}");
                Snackbar.Add($"Voice apply error: {ex.Message}", Severity.Error);
            }
        }

        if (appliedCount > 0)
        {
            Snackbar.Add($"Applied {appliedCount} voice command(s).", Severity.Success);
        }

        if (failedMessages.Count > 0)
        {
            _debugStatus = string.Join(" | ", failedMessages);
            SetVoiceStatus(
                SpeechStatusLevel.Warning,
                appliedCount > 0
                    ? $"Applied {appliedCount} voice command(s), but {failedMessages.Count} need review."
                    : $"No voice commands were applied. Review {failedMessages.Count} failed attempt(s).");
        }
        else if (appliedCount > 0)
        {
            SetVoiceStatus(SpeechStatusLevel.Info, $"Applied {appliedCount} voice command(s).");
        }

        await LoadAsync();
        await InvokeAsync(StateHasChanged);
    }

    private void OnListeningChanged(bool isListening)
    {
        if (_isDisposed)
            return;

        _isListening = isListening;
        _ = InvokeAsync(StateHasChanged);
    }

    private void OnSpeechStatusChanged(SpeechStatusUpdate update)
    {
        if (_isDisposed)
            return;

        SetVoiceStatus(update.Level, update.Message);

        if (update.Level == SpeechStatusLevel.Warning)
            Snackbar.Add(update.Message, Severity.Warning);
        else if (update.Level == SpeechStatusLevel.Error)
            Snackbar.Add(update.Message, Severity.Error);

        _ = InvokeAsync(StateHasChanged);
    }

    private async Task UpdateIso(AnesthesiaBucket bucket, decimal? value)
    {
        await SaveFieldValueAsync(bucket.Id, AnesthesiaFieldKeys.IsoPercent, value);
    }

    private async Task UpdateO2(AnesthesiaBucket bucket, decimal? value)
    {
        await SaveFieldValueAsync(bucket.Id, AnesthesiaFieldKeys.OxygenFlowRate, value);
    }

    private async Task UpdateEtco2(AnesthesiaBucket bucket, decimal? value)
    {
        await SaveFieldValueAsync(bucket.Id, AnesthesiaFieldKeys.Etco2, value);
    }

    private async Task UpdateSpo2(AnesthesiaBucket bucket, int? value)
    {
        await SaveFieldValueAsync(bucket.Id, AnesthesiaFieldKeys.Spo2, value);
    }

    private async Task UpdateTemperature(AnesthesiaBucket bucket, decimal? value)
    {
        await SaveFieldValueAsync(bucket.Id, AnesthesiaFieldKeys.Temperature, value);
    }

    private async Task UpdateHeartRate(AnesthesiaBucket bucket, int? value)
    {
        await SaveFieldValueAsync(bucket.Id, AnesthesiaFieldKeys.HeartRate, value);
    }

    private async Task UpdateRespiratoryRate(AnesthesiaBucket bucket, int? value)
    {
        await SaveFieldValueAsync(bucket.Id, AnesthesiaFieldKeys.RespiratoryRate, value);
    }

    private async Task UpdateSystolic(AnesthesiaBucket bucket, int? value)
    {
        await SaveFieldValueAsync(bucket.Id, AnesthesiaFieldKeys.SystolicBp, value);
    }

    private async Task UpdateDiastolic(AnesthesiaBucket bucket, int? value)
    {
        await SaveFieldValueAsync(bucket.Id, AnesthesiaFieldKeys.DiastolicBp, value);
    }

    private async Task UpdateMap(AnesthesiaBucket bucket, int? value)
    {
        await SaveFieldValueAsync(bucket.Id, AnesthesiaFieldKeys.Map, value);
    }

    private async Task RefreshActiveBucket()
    {
        _activeBucket = await BucketService.GetActiveBucketAsync(SessionId);
        await LoadAsync();
    }

    private static Severity MapAlertSeverity(VetAlertLevel level) =>
        level switch
        {
            VetAlertLevel.Critical => Severity.Error,
            VetAlertLevel.Warning => Severity.Warning,
            _ => Severity.Info
        };

    private async Task UndoLastVoiceEntry()
    {
        try
        {
            var log = await VoiceCommandApplicationService.UndoLastAppliedCommandAsync(SessionId, DateTime.Now, "manual undo");
            SetVoiceStatus(log.Applied ? SpeechStatusLevel.Info : SpeechStatusLevel.Warning, log.StatusMessage ?? "Undo processed.");
            Snackbar.Add(log.StatusMessage ?? "Undo processed.", log.Applied ? Severity.Success : Severity.Warning);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            SetVoiceStatus(SpeechStatusLevel.Error, $"Undo failed: {ex.Message}");
            Snackbar.Add($"Undo failed: {ex.Message}", Severity.Error);
        }
    }

    private async Task CopyHandoffSummary()
    {
        await ClipboardService.SetTextAsync(_handoffSummary);
        Snackbar.Add($"{SelectedExportTarget.Label} copied.", Severity.Success);
    }

    private async Task ShareBucketCsv()
    {
        if (_session is null)
            return;

        var filePath = await SessionStructuredExportService.ExportBucketCsvAsync(_animal, _session, _clinicSettings, _buckets);
        var shareTitle = string.IsNullOrWhiteSpace(_clinicSettings.CsvShareTitle)
            ? $"Share {GetCsvLabel()}"
            : _clinicSettings.CsvShareTitle.Trim();
        await FileShareService.ShareFileAsync(filePath, shareTitle);
        Snackbar.Add($"{GetCsvLabel()} ready to share.", Severity.Success);
    }

    private async Task ToggleSessionComplete()
    {
        if (_session is null)
            return;

        var isCompleting = _session.SessionEndTime is null;
        _session.SessionEndTime = isCompleting ? DateTime.Now : null;
        await Repository.SaveSessionAsync(_session);
        await WorkflowTelemetryService.RecordSessionCompletionChangeAsync(_session.Id, isCompleting);
        Snackbar.Add(
            _session.SessionEndTime is null ? "Procedure reopened." : "Procedure marked complete.",
            Severity.Success);
        await LoadAsync();
    }

    private async Task SaveFieldValueAsync(Guid bucketId, string fieldKey, decimal? value)
    {
        try
        {
            var previousValue = _buckets.FirstOrDefault(x => x.Id == bucketId) is { } existingBucket
                ? GetBucketFieldValue(existingBucket, fieldKey)
                : null;

            if (value.HasValue)
                await BucketService.ApplyFieldValueAsync(bucketId, fieldKey, value.Value);
            else
                await BucketService.ClearFieldAsync(bucketId, fieldKey);

            if (previousValue != value)
            {
                await WorkflowTelemetryService.RecordManualCorrectionAsync(
                    SessionId,
                    bucketId,
                    fieldKey,
                    $"{FormatTelemetryValue(previousValue)} -> {FormatTelemetryValue(value)}");
            }

            await RefreshActiveBucket();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Warning);
            await LoadAsync();
        }
    }

    private bool CanUndoLastVoiceEntry =>
        _recentVoiceLogs.Any(x => x.Applied && !x.Undone && !string.Equals(x.MatchedCommandType, nameof(VoiceCommandType.Undo), StringComparison.OrdinalIgnoreCase));

    private void SetVoiceStatus(SpeechStatusLevel level, string message)
    {
        _voiceStatusLevel = level;
        _voiceStatus = message;
        _debugStatus = message;
    }

    private static Severity MapSpeechSeverity(SpeechStatusLevel level) =>
        level switch
        {
            SpeechStatusLevel.Error => Severity.Error,
            SpeechStatusLevel.Warning => Severity.Warning,
            _ => Severity.Info
        };

    private static Color MapSpeechChipColor(SpeechStatusLevel level) =>
        level switch
        {
            SpeechStatusLevel.Error => Color.Error,
            SpeechStatusLevel.Warning => Color.Warning,
            _ => Color.Success
        };

    private static string DescribeVoiceState(SpeechStatusLevel level) =>
        level switch
        {
            SpeechStatusLevel.Error => "Needs attention",
            SpeechStatusLevel.Warning => "Review needed",
            _ => "Ready"
        };

    public async ValueTask DisposeAsync()
    {
        _isDisposed = true;
        SpeechService.SpeechRecognized -= OnSpeechRecognized;
        SpeechService.ListeningChanged -= OnListeningChanged;
        SpeechService.StatusChanged -= OnSpeechStatusChanged;

        if (!SpeechService.IsListening)
            return;

        try
        {
            await SpeechService.StopAsync();
        }
        catch
        {
        }
    }

    private async Task UpdateProcedure(string value)
    {
        if (_session is null)
            return;

        _session.Procedure = value;
        await Repository.SaveSessionAsync(_session);
        await LoadAsync();
    }

    private static Severity MapCompletionSeverity(SessionCompletionItem item) =>
        item.IsComplete
            ? Severity.Success
            : item.Level switch
            {
                VetAlertLevel.Critical => Severity.Error,
                VetAlertLevel.Warning => Severity.Warning,
                _ => Severity.Info
            };

    private static Color MapVoiceLogColor(VoiceEntryLog log)
    {
        if (log.Undone)
            return Color.Info;

        return log.Applied ? Color.Success : Color.Warning;
    }

    private static string DescribeVoiceLogOutcome(VoiceEntryLog log)
    {
        if (log.Undone)
            return "Undone";

        return log.Applied ? "Applied" : "Needs review";
    }

    private string GetCsvLabel() =>
        string.IsNullOrWhiteSpace(_clinicSettings.CsvExportLabel)
            ? "Bucket CSV"
            : _clinicSettings.CsvExportLabel.Trim();

    private async Task UpdateConfiguredField(AnesthesiaBucket bucket, string fieldKey, decimal? value) =>
        await SaveFieldValueAsync(bucket.Id, fieldKey, value);

    private static decimal? GetBucketFieldValue(AnesthesiaBucket bucket, string fieldKey) =>
        fieldKey switch
        {
            AnesthesiaFieldKeys.IsoPercent => bucket.IsoPercent,
            AnesthesiaFieldKeys.OxygenFlowRate => bucket.OxygenFlowRate,
            AnesthesiaFieldKeys.Etco2 => bucket.Etco2,
            AnesthesiaFieldKeys.Spo2 => bucket.Spo2,
            AnesthesiaFieldKeys.Temperature => bucket.Temperature,
            AnesthesiaFieldKeys.HeartRate => bucket.HeartRate,
            AnesthesiaFieldKeys.RespiratoryRate => bucket.RespiratoryRate,
            AnesthesiaFieldKeys.SystolicBp => bucket.SystolicBp,
            AnesthesiaFieldKeys.DiastolicBp => bucket.DiastolicBp,
            AnesthesiaFieldKeys.Map => bucket.Map,
            _ => null
        };

    private static string FormatTelemetryValue(decimal? value) =>
        value.HasValue ? value.Value.ToString("0.##") : "cleared";
}

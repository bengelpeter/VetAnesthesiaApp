    private async Task RefreshActiveBucket()
    {
        _activeBucket = await BucketService.GetActiveBucketAsync(SessionId);
        await LoadAsync();
    }

    private static Severity MapAlertSeverity(VetAlertLevel level) =>
        level switch
        {
            VetAlertLevel.Critical => Severity.Error,
            VetAlertLevel.Warning => Severity.Warning,
            _ => Severity.Info
        };

    private async Task SaveClinicSettingsAsync()
    {
        await Repository.SaveClinicSettingsAsync(_clinicSettings);
        await LoadAsync();
        Snackbar.Add("VetPulse settings saved.", Severity.Success);
    }

    private async Task UpdateMonitoringInterval(int value)
    {
        _clinicSettings.MonitoringIntervalMinutes = Math.Max(1, value);
        await SaveClinicSettingsAsync();
    }

    private async Task UpdateMissingVitalsThreshold(int value)
    {
        _clinicSettings.MissingVitalsAlertAfterMinutes = Math.Max(1, value);
        await SaveClinicSettingsAsync();
    }

    private async Task UpdateSpo2Threshold(int value)
    {
        _clinicSettings.Spo2LowThreshold = Math.Clamp(value, 1, 100);
        await SaveClinicSettingsAsync();
    }

    private async Task UpdateMapThreshold(int value)
    {
        _clinicSettings.MapLowThreshold = Math.Max(1, value);
        await SaveClinicSettingsAsync();
    }

    private async Task UpdateTemperatureDropThreshold(decimal value)
    {
        _clinicSettings.TemperatureDropAlertDelta = value <= 0 ? 0.5m : value;
        await SaveClinicSettingsAsync();
    }

    private async Task UpdateClinicName(string value)
    {
        _clinicSettings.ClinicName = value;
        await SaveClinicSettingsAsync();
    }

    private async Task UpdatePreferredExportTarget(string value)
